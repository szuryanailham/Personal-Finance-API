# Salin ke .env di server (cp .env.example .env && chmod 600 .env), lalu isi semua nilai <...>.
# Generate password: openssl rand -base64 32

# Database
DB_NAME=personal-finance
DB_USERNAME=pf_app
DB_PASSWORD=<isi>

# Redis (state OTP)
REDIS_PASSWORD=<isi>

# Origin frontend yang boleh akses API (pisahkan dengan koma)
CORS_ALLOWED_ORIGINS=https://app.domainkamu.com
APP_TIMEZONE=Asia/Jakarta

# Login Google: OAuth client ID produksi
GOOGLE_CLIENT_IDS=<isi>

# SMTP produksi untuk email OTP (Mailpit hanya untuk dev)
MAIL_HOST=<smtp host>
MAIL_PORT=587
MAIL_USERNAME=<isi>
MAIL_PASSWORD=<isi>
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@domainkamu.com
MAIL_APP_NAME=Artoku

# Override setelan dev di application.properties
SPRING_JPA_SHOW_SQL=false
LOGGING_LEVEL_ORG_FLYWAYDB=INFO
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2
