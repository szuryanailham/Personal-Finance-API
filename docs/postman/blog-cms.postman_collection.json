{
  "info": {
    "name": "Blog CMS - Posts, Categories and Tags",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "tagId",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
    },
    {
      "key": "articleSlug",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login CMS",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/blog/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login succeeded\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "categories",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/blog/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Personal Finance\",\n  \"slug\": \"personal-finance\",\n  \"description\": \"Tips mengelola keuangan pribadi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Created\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"categoryId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/blog/categories?page=0&size=20&search="
          }
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/blog/categories/{{categoryId}}"
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/blog/categories/{{categoryId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Personal Finance Updated\",\n  \"slug\": \"personal-finance\",\n  \"description\": \"Tips mengelola keuangan pribadi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/blog/categories/{{categoryId}}"
          }
        }
      ]
    },
    {
      "name": "tags",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/blog/tags",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budgeting\",\n  \"slug\": \"budgeting\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Created\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"tagId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/blog/tags?page=0&size=20&search="
          }
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/blog/tags/{{tagId}}"
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/blog/tags/{{tagId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budgeting Updated\",\n  \"slug\": \"budgeting\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/blog/tags/{{tagId}}"
          }
        }
      ]
    },
    {
      "name": "Create blog post",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/blog/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "blog",
            "posts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Cara mengatur keuangan bulanan\",\n  \"slug\": \"cara-mengatur-keuangan-bulanan\",\n  \"excerpt\": \"Panduan anggaran\",\n  \"contentHtml\": \"<p>Catat pemasukan dan pengeluaran.</p>\",\n  \"status\": \"DRAFT\",\n  \"categoryIds\": [\n    \"{{categoryId}}\"\n  ],\n  \"tagIds\": [\n    \"{{tagId}}\"\n  ]\n}"
        }
      }
    },
    {
      "name": "List blog posts (CMS)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/blog/posts?skip=0&limit=20"
      }
    },
    {
      "name": "Patch blog post (CMS)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/blog/posts/{{postId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Judul artikel diperbarui\",\n  \"tagIds\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Detail Post CMS",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/blog/posts/{{postId}}",
        "description": "Detail lengkap sebelum PATCH. AUTHOR: artikel milik sendiri; ADMIN/EDITOR: semua artikel aktif. Memerlukan token CMS."
      }
    },
    {
      "name": "Soft Delete Post CMS",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/blog/posts/{{postId}}",
        "description": "Tanpa body. AUTHOR hanya draft miliknya; ADMIN/EDITOR semua status. Soft delete mempertahankan konten dan relasi; reservasi slug dilepas agar dapat dipakai ulang. Memerlukan token CMS."
      }
    },
    {
      "name": "Public Article List",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/blog/published?skip=0&limit=20"
      }
    },
    {
      "name": "Public Article Detail",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/blog/published/{{articleSlug}}"
      }
    }
  ]
}
