{
  "info": {
    "name": "Blog CMS - Categories and Tags",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "tagId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login CMS",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/blog/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login succeeded\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "categories",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/blog/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Personal Finance\",\n  \"slug\": \"personal-finance\",\n  \"description\": \"Tips mengelola keuangan pribadi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Created\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"categoryId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/blog/categories?page=0&size=20&search="
          }
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/blog/categories/{{categoryId}}"
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/blog/categories/{{categoryId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Personal Finance Updated\",\n  \"slug\": \"personal-finance\",\n  \"description\": \"Tips mengelola keuangan pribadi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/blog/categories/{{categoryId}}"
          }
        }
      ]
    },
    {
      "name": "tags",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/blog/tags",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budgeting\",\n  \"slug\": \"budgeting\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Created\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"tagId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/blog/tags?page=0&size=20&search="
          }
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/blog/tags/{{tagId}}"
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/blog/tags/{{tagId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budgeting Updated\",\n  \"slug\": \"budgeting\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/blog/tags/{{tagId}}"
          }
        }
      ]
    }
  ]
}
